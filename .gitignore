########################################
# OS / Editor / General
########################################
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
*~
.#*

########################################
# Go (Golang)
########################################
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries
*.test

# Coverage / profiling
*.out
coverage.*
*.coverprofile
profile.cov

# Build output
/bin/
/dist/
/build/

# Go workspace
go.work
go.work.sum

# Env files
.env

########################################
# Terraform / OpenTofu / Terragrunt
########################################
# Local state & cache (MUST ignore)
**/.terraform/*
**/.terraform.d/

# Terragrunt cache
.terragrunt-cache/

# State files
*.tfstate
*.tfstate.*
terraform.tfstate.d/

# Variable files (often contain secrets)
*.tfvars
*.tfvars.json

# Plan files
*.tfplan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock + config
.terraform.lock.hcl
terraform.rc

# Logs / crash dumps
crash.log
crash.*.log

########################################
# Kubernetes / Helm
########################################
# Rendered / generated manifests
rendered/
manifests/
kustomize-build/

# Helm
charts/**/charts/
charts/**/tmp/
*.tgz

# K8s / tooling cache
.kube/cache/
.skaffold/
.kompose/

# Secrets (important)
secrets/*.yaml
*.pem

########################################
# Logs / Temp / Runtime
########################################
*.log
*.tmp
*.temp

########################################
# Containers / Images
########################################
*.tar
*.gz

########################################
# Misc
########################################
*.bak
*.backup
*.old