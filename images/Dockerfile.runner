# syntax=docker/dockerfile:1

FROM alpine:3.22.4 AS runner

ARG TERRAGRUNT_VERSION=1.0.5
ARG OPENTOFU_VERSION=1.12.0

RUN apk add --no-cache \
    bash \
    ca-certificates \
    curl \
    git \
    openssh-client \
    tar \
    unzip

# ---- Install OpenTofu ----
# OpenTofu release assets are distributed as: opentofu_<ver>_linux_amd64.zip
RUN set -eux; \
    curl -fsSL -o /tmp/opentofu.zip \
    https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/opentofu_${OPENTOFU_VERSION}_linux_amd64.zip; \
    unzip -q /tmp/opentofu.zip -d /usr/local/bin; \
    rm -f /tmp/opentofu.zip; \
    chmod +x /usr/local/bin/tofu || true; \
    # Some distributions ship binary named "tofu"; verify.
    [ -f /usr/local/bin/tofu ]

# ---- Install Terragrunt ----
# Terragrunt release assets are distributed as: terragrunt_linux_amd64
RUN set -eux; \
    curl -fsSL -o /usr/local/bin/terragrunt \
    https://github.com/gruntwork-io/terragrunt/releases/download/v${TERRAGRUNT_VERSION}/terragrunt_linux_amd64; \
    chmod +x /usr/local/bin/terragrunt

# Basic dirs expected by typical gitops/runner workflows
WORKDIR /work

# Ensure PATH includes common locations
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Default to a no-op command; controller should override with specific args/entrypoint.
ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["echo 'terragrunt-runner ready'; sleep infinity"]
